<% if (typeof success !== "undefined" && success.length > 0) { %>

```
<script>
    document.addEventListener("DOMContentLoaded", function () {

        Swal.fire({
            icon: "success",
            title: "Success!",
            text: "<%= success[0] %>",
            confirmButtonText: "OK"
        });

    });
</script>
```

<% } %>

<% if (typeof error !== "undefined" && error.length > 0) { %>

```
<script>
    document.addEventListener("DOMContentLoaded", function () {

        Swal.fire({
            icon: "error",
            title: "Oops!",
            text: "<%= error[0] %>",
            confirmButtonText: "OK"
        });

    });
</script>
```

<% } %>
