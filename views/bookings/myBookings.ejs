<% layout("/layouts/boilerplate") %>
<div class="container my-5">

    <div class="mb-4">

        <h2 class="fw-bold">
            <i class="fa-solid fa-calendar-check"></i>
            My Bookings
        </h2>

        <p class="text-muted">
            Manage your upcoming and previous stays.
        </p>

    </div>


    <% if (!bookings || bookings.length === 0) { %>

        <!-- ==============================
             NO BOOKINGS
        =============================== -->

        <div class="text-center py-5">

            <i
                class="fa-regular fa-calendar-xmark"
                style="font-size: 60px;">
            </i>

            <h4 class="mt-4">
                No bookings yet
            </h4>

            <p class="text-muted">
                You haven't booked any stays yet.
            </p>

            <a
                href="/listings"
                class="btn auth-btn">

                <i class="fa-solid fa-compass"></i>
                Explore Listings

            </a>

        </div>

    <% } else { %>

        <!-- ============ BOOKING LIST ============== -->

        <div class="row g-4">

            <% bookings.forEach(booking => { %>

                <div class="col-12">

                    <div class="card border-0 shadow-sm booking-history-card">

                        <div class="row g-0">


                            <!-- LISTING IMAGE -->

                            <div class="col-md-4">

                                <% if (
                                    booking.listing &&
                                    booking.listing.image &&
                                    booking.listing.image.url
                                ) { %>

                                    <img
                                        src="<%= booking.listing.image.url %>"
                                        class="img-fluid booking-history-image"
                                        alt="<%= booking.listing.title %>">

                                <% } else { %>

                                    <div class="booking-no-image">
                                        <i class="fa-solid fa-house"></i>
                                    </div>

                                <% } %>

                            </div>

                            <!-- BOOKING DETAILS -->

                            <div class="col-md-8">

                                <div class="card-body">

                                    <% if (booking.listing) { %>

                                        <h4 class="card-title fw-bold">

                                            <%= booking.listing.title %>

                                        </h4>

                                        <p class="text-muted mb-3">

                                            <i class="fa-solid fa-location-dot"></i>

                                            <%= booking.listing.location %>,
                                            <%= booking.listing.country %>

                                        </p>

                                    <% } %>

                                    <%#  DATES %>

                                    <div class="row mb-3">

                                        <div class="col-sm-6">

                                            <small class="text-muted">
                                                Check-in
                                            </small>

                                            <div class="fw-semibold">

                                                <%= new Date(
                                                    booking.checkIn
                                                ).toLocaleDateString(
                                                    "en-IN",
                                                    {
                                                        day: "numeric",
                                                        month: "short",
                                                        year: "numeric"
                                                    }
                                                ) %>

                                            </div>

                                        </div>


                                        <div class="col-sm-6">

                                            <small class="text-muted">
                                                Check-out
                                            </small>

                                            <div class="fw-semibold">

                                                <%= new Date(
                                                    booking.checkOut
                                                ).toLocaleDateString(
                                                    "en-IN",
                                                    {
                                                        day: "numeric",
                                                        month: "short",
                                                        year: "numeric"
                                                    }
                                                ) %>

                                            </div>

                                        </div>

                                    </div>


                                    <%# GUESTS + NIGHTS %>

                                    <div class="row mb-3">

                                        <div class="col-sm-6">

                                            <small class="text-muted">
                                                Guests
                                            </small>

                                            <div class="fw-semibold">

                                                <i class="fa-solid fa-user-group"></i>

                                                <%= booking.guests %>

                                            </div>

                                        </div>


                                        <div class="col-sm-6">

                                            <small class="text-muted">
                                                Stay
                                            </small>

                                            <div class="fw-semibold">

                                                <%= booking.totalNights %>

                                                <%= booking.totalNights === 1
                                                    ? "night"
                                                    : "nights"
                                                %>

                                            </div>

                                        </div>

                                    </div>

                                    <%# PRICE %>

                                    <div class="booking-total">

                                        <span>
                                            Total
                                        </span>

                                        <strong>

                                            ₹<%= booking.totalPrice.toLocaleString(
                                                "en-IN"
                                            ) %>

                                        </strong>

                                    </div>


                                  <%# STATUS %>

                                    <div class="mt-3">

                                        <% if (booking.status === "Confirmed") { %>

                                            <span class="badge bg-success">

                                                <i class="fa-solid fa-circle-check"></i>

                                                     Confirmed

                                            </span>

                                        <% } else if (booking.status === "Cancelled") { %>

                                             <span class="badge bg-danger">

                                                 <i class="fa-solid fa-circle-xmark"></i>

                                                    Cancelled

                                            </span>

                                        <% } else if (booking.status === "Completed") { %>

                                             <span class="badge bg-secondary">

                                                <i class="fa-solid fa-check-double"></i>

                                                     Completed

                                            </span>

                                        <% } else { %>

                                            <span class="badge bg-secondary">

                                                <%= booking.status || "Unknown" %>

                                            </span>

                                        <% } %>

                                    </div>

                                    <%# STATUS MESSAGE %>

                                    <div class="mt-2">

                                        <% if (booking.status === "Confirmed") { %>

                                            <p class="text-success small mb-0">
                                                <i class="fa-solid fa-circle-check"></i>
                                                    Your booking is confirmed.
                                             </p>

                                        <% } else if (booking.status === "Cancelled") { %>

                                            <p class="text-danger small mb-0">
                                                <i class="fa-solid fa-circle-xmark"></i>
                                                This booking has been cancelled.
                                            </p>

                                        <% } else if (booking.status === "Completed") { %>

                                            <p class="text-muted small mb-0">
                                                <i class="fa-solid fa-check-double"></i>
                                                     Your stay has been completed.
                                            </p>

                                        <% } %>

                                </div>

                                
                                    <% if (booking.listing) { %>

                                        <a
                                            href="/bookings/<%= booking._id %>"
                                            class="btn auth-btn mt-3">

                                            <i class="fa-solid fa-calendar-check"></i>

                                            View Booking

                                        </a>

                                        <a
                                            href="/listings/<%= booking.listing._id %>"
                                            class="btn btn-outline-secondary mt-3">

                                            <i class="fa-solid fa-eye"></i>

                                            View Listing

                                        </a>

                                            <% if (
                                                booking.status !== "Cancelled" &&
                                                 booking.status !== "Completed"
                                                ) { %>
                                                <form
                                                    action="/my-bookings/<%= booking._id %>/cancel"
                                                    method="POST"
                                                     class="d-inline">

                                                        <button
                                                             type="submit"
                                                            class="btn btn-outline-danger mt-3">

                                                             <i class="fa-solid fa-xmark"></i>

                                                                Cancel   Booking

                                                        </button>

                                                    </form>

                                            <% } %>

                                    <% } %>


                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            <% }) %>

        </div>

    <% } %>

</div>