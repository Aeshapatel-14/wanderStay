<% layout("/layouts/boilerplate") %>

<div class="container my-5">

    <div class="booking-confirmation">

    <!-- BOOKING STATUS HEADER -->

    <% if (booking.status === "Confirmed") { %>

            <div class="confirmation-icon">

                 <i class="fa-solid fa-check"></i>

            </div>

            <h2 class="fw-bold mt-4">

                Booking Confirmed!

            </h2>

            <p class="text-muted">

                Your stay has been successfully booked.
            </p>

        <% } else if (booking.status === "Cancelled") { %>

            <div class="confirmation-icon">
                <i class="fa-solid fa-xmark"></i>
            </div>

            <h2 class="fw-bold mt-4">
                Booking Cancelled
            </h2>

            <p class="text-muted">
                This booking has been cancelled.
             </p>

        <% } else if (booking.status === "Completed") { %>

            <div class="confirmation-icon">
                <i class="fa-solid fa-check-double"></i>
            </div>

            <h2 class="fw-bold mt-4">
                Stay Completed
            </h2>

            <p class="text-muted">
                Your stay has been completed
                 successfully.
            </p>

        <% } else { %>

            <div class="confirmation-icon">
                <i class="fa-solid fa-calendar-check"></i>
            </div>

            <h2 class="fw-bold mt-4">
                Booking Details
            </h2>

            <p class="text-muted">
                 View your booking information below.
            </p>

    <% } %>

        <!-- BOOKING CARD -->

        <div class="confirmation-card">

            <!-- LISTING -->

            <% if (booking.listing) { %>

                <div class="confirmation-listing">

                    <% if (
                        booking.listing.image &&
                        booking.listing.image.url
                    ) { %>

                        <img
                            src="<%= booking.listing.image.url %>"
                            alt="<%= booking.listing.title %>"
                            class="confirmation-image">

                    <% } %>

                    <div>

                        <h4 class="fw-bold mb-1">

                            <%= booking.listing.title %>

                        </h4>

                        <p class="text-muted mb-0">

                            <i class="fa-solid fa-location-dot"></i>

                            <%= booking.listing.location %>,
                            <%= booking.listing.country %>

                        </p>

                    </div>

                </div>

            <% } %>

            <hr>

                <%# BOOKING DETAILS %>

                <div class="confirmation-details">

                    <!-- PRICE / NIGHT -->

                    <div class="confirmation-detail">

                        <span>
                            <i class="fa-solid fa-indian-rupee-sign"></i>
                            Price / night
                        </span>

                        <strong>
                            ₹<%= booking.listing.price.toLocaleString("en-IN") %>
                        </strong>

                    </div>

                <%# CHECK-IN %>

                    <div class="confirmation-detail">

                        <span>
                            <i class="fa-regular fa-calendar"></i>
                                Check-in
                        </span>

                        <strong>

                            <%= new Date(
                                booking.checkIn
                                ).toLocaleDateString(
                                "en-IN",
                                {
                                    day: "numeric",
                                    month: "short",
                                    year: "numeric"
                                }
                            ) %>

                        </strong>

                    </div>

                <%# CHECK-OUT %>

                    <div class="confirmation-detail">

                     <span>
                        <i class="fa-regular fa-calendar"></i>
                            Check-out
                    </span>

                    <strong>

                        <%= new Date(
                            booking.checkOut
                            ).toLocaleDateString(
                            "en-IN",
                            {
                                day: "numeric",
                                month: "short",
                                year: "numeric"
                            }
                        ) %>

                    </strong>

                   </div>

                    <%# STAY %>

                        <div      class="confirmation-detail">

                            <span>
                                <i class="fa-solid fa-moon"></i>
                                 Stay
                            </span>

                            <strong>
                                <%= booking.totalNights %>

                                <%= booking.totalNights === 1
                                ? "night"
                                : "nights"
                                %>  
                            </strong>

                        </div>

                        <%# GUESTS %>

                            <div class="confirmation-detail">

                                 <span>
                                    <i class="fa-solid fa-user-group"></i>
                                     Guests
                                </span>

                                <strong>
                                     <%= booking.guests %>
                                </strong>

                            </div>

                        </div>

                    <hr>

            <%# TOTAL %>

            <div class="confirmation-total">

                <span>
                    Total Amount
                </span>

                <strong>

                    ₹<%= booking.totalPrice.toLocaleString(
                        "en-IN"
                    ) %>

                </strong>

            </div>

            <%# STATUS  %>

            <div class="mt-3">

                <% if (booking.status === "Confirmed") { %>

                    <span class="badge bg-success">

                        <i class="fa-solid fa-circle-check"></i>
                            Confirmed

                    </span>

                    <% } else if (booking.status === "Cancelled") { %>

                    <span class="badge bg-danger">

                        <i class="fa-solid fa-circle-xmark"></i>
                        Cancelled

                    </span>

                    <% } else if (booking.status === "Completed") { %>

                        <span class="badge bg-secondary">

                            <i class="fa-solid fa-check-double"></i>

                            Completed

                        </span>

                    <% } else { %>

                <span class="badge bg-secondary">

            <%= booking.status || "Unknown" %>

        </span>

    <% } %>

</div>

<%# STATUS MESSAGE %>

<div class="mt-3">

    <% if (booking.status === "Confirmed") { %>

        <p class="text-success mb-0">
            <i class="fa-solid fa-circle-check"></i>
            Your stay is confirmed. We look forward to hosting you!
        </p>

    <% } else if (booking.status === "Cancelled") { %>

        <p class="text-danger mb-0">
            <i class="fa-solid fa-circle-xmark"></i>
            This booking has been cancelled.
        </p>

    <% } else if (booking.status === "Completed") { %>

        <p class="text-muted mb-0">
            <i class="fa-solid fa-check-double"></i>
            This stay has been completed.
        </p>

    <% } %>

</div>
           
     <%# BOOKING ID %>
         <div class="booking-id">

            <small class="text-muted">
                Booking ID
            </small>

            <div class="fw-semibold">

                 #<%= booking._id.toString().slice(-8).toUpperCase() %>

            </div>
    </div>
</div>

    <%# ACTIONS %>

    <div class="confirmation-actions">

        <%# MY BOOKING %>
        <a
            href="/my-bookings"
            class="btn auth-btn">

            <i class="fa-solid fa-calendar-check"></i>
            My Bookings

        </a>

        <%# VIEW LISTING %>

             <% if (booking.listing) { %>

                <a
                    href="/listings/<%= booking.listing._id %>"
                    class="btn btn-outline-secondary">

                    <i class="fa-solid fa-eye"></i>
                    View Listing
                </a>

            <% } %>

            <%# CANCEL BUTTON %>

                <% if (booking.status === "Confirmed") { %>

                    <button
                        type="button"
                        class="btn btn-outline-danger"
                        data-bs-toggle="modal"
                        data-bs-target="#cancelBookingModal">

                            <i class="fa-solid fa-xmark"></i>
                            Cancel Booking
                    </button>

                <% } %>

                <% if (booking.status === "Cancelled") { %>

                    <span class="btn btn-outline-danger disabled">
                        <i class="fa-solid fa-circle-xmark"></i>
                         Booking Cancelled
                    </span>

                <% } else if (booking.status === "Completed") { %>

                    <span class="btn btn-outline-secondary disabled">

                        <i class="fa-solid fa-check-double"></i>
                        Stay Completed

                     </span>

                <% } %>

                <%# EXPORE LISTING %>
                <a
                    href="/listings"
                    class="btn btn-outline-secondary">

                    <i class="fa-solid fa-compass"></i>
                    Explore Listings

                </a>

            </div>

        </div>

    </div>

<%# CANCEL BOOKING MODAL %>

<div
    class="modal fade"
    id="cancelBookingModal"
    tabindex="-1"
    aria-labelledby="cancelBookingModalLabel"
    aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <%# HEADER  %>

            <div class="modal-header">

                <h5
                    class="modal-title fw-bold"
                    id="cancelBookingModalLabel">
                    Cancel Booking?

                </h5>

                <button
                    type="button"
                    class="btn-close"
                    data-bs-dismiss="modal"
                    aria-label="Close">
                </button>

            </div>

            <%# BODY %>

            <div class="modal-body">

                <p class="mb-2">

                    Are you sure you want to cancel this booking?

                </p>

                <p class="text-muted small mb-0">

                    Once cancelled, this booking cannot be restored.

                </p>

            </div>

            <%# FOOTER %>

            <div class="modal-footer">

                <button
                    type="button"
                    class="btn btn-secondary"
                    data-bs-dismiss="modal">
                    Keep Booking
                </button>

                <%# ACTUAL CANCEL FORM %>

                <form
                    action="/my-bookings/<%= booking._id %>/cancel"
                    method="POST"
                    class="d-inline">

                    <button
                        type="submit"
                        class="btn btn-danger">

                        <i class="fa-solid fa-xmark"></i>

                        Yes, Cancel Booking

                    </button>

                </form>

            </div>

        </div>

    </div>

</div>