<%- layout("/layouts/boilerplate") %>

<div class="container auth-container">

    <div class="row justify-content-center">

        <div class="col-lg-5 col-md-7 col-sm-9 col-12">

            <div class="card shadow auth-card">

                <div class="card-body p-4">

                    <h2 class="text-center auth-title">
                        <i class="fa-solid fa-right-to-bracket"></i>
                        Welcome Back
                    </h2>

                    <p class="text-center auth-subtitle">
                        Login to your WanderStay account
                    </p>

                    <form
                        action="/users/login"
                        method="POST"
                        class="needs-validation auth-form"
                        novalidate>

                        <!--======================== Username=============================== -->
                        <div class="mb-3">

                            <label for="username" class="form-label">
                                Username
                            </label>

                            <input
                                type="text"
                                id="username"
                                name="username"
                                class="form-control"
                                placeholder="Enter your username"
                                required >

                            <div class="invalid-feedback">
                                Please enter your username.
                            </div>

                        </div>

                        <!-- ===========================Password======================== -->
                        <div class="mb-4">

                            <label for="password" class="form-label">
                                Password
                            </label>

                            <input
                                type="password"
                                id="password"
                                name="password"
                                class="form-control"
                                placeholder="Enter your password"
                                required>

                            <div class="invalid-feedback">
                                Please enter your password.
                            </div>

                        </div>

                        <!-- ========================Login Button ========================-->
                         <button
                            type="submit"
                             class="btn auth-btn w-100"
                            id="loginBtn">

                            <i class="fa-solid fa-arrow-right-to-bracket"></i>

                            <span       class="btn-text">
                                Login
                            </span>

                        </button>

                    </form>

                    <div class="text-center mt-4">

                        Don't have an account?

                     <!-- ======================sign up ===================== -->

                        <a href="/users/signup" class="auth-link">

                            Sign Up
                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>